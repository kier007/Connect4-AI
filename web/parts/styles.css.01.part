:root{
  color-scheme:dark;
  --bg:#0c0d0e;
  --surface:#151719;
  --surface-2:#1c1e21;
  --surface-3:#23262a;
  --line:#2b2e32;
  --text:#f4f1ea;
  --muted:#8c8d91;
  --muted-2:#66686d;
  --board:#e3ded3;
  --hole:#111315;
  --red:#e65b50;
  --red-deep:#bb4139;
  --yellow:#e3b84f;
  --yellow-deep:#b88a2d;
  --accent:#f4f1ea;
  --radius:24px;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body,#root{margin:0;width:100%;min-height:100%;background:var(--bg);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--text);overscroll-behavior:none}
body{min-height:100vh}
button{font:inherit;color:inherit}
button:focus-visible{outline:2px solid #d9d4ca;outline-offset:3px}
.icon{width:20px;height:20px;display:block}
.app{min-height:100vh;background:var(--bg);overflow:hidden}
.minimalist-app{display:flex;justify-content:center}
.screen-enter{animation:screenIn .38s cubic-bezier(.22,.8,.24,1) both}
@keyframes screenIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.fade-in{animation:fadeIn .22s ease both}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.slide-up{animation:slideUp .32s cubic-bezier(.22,.85,.25,1) both}
@keyframes slideUp{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:none}}

/* Home */
.home-screen{width:min(100%,560px);min-height:100vh;padding:calc(54px + env(safe-area-inset-top)) 24px calc(28px + env(safe-area-inset-bottom));display:flex;flex-direction:column}
.home-header{padding:10px 2px 38px}
.logo-mark{width:46px;height:46px;display:grid;grid-template-columns:repeat(2,1fr);gap:4px;padding:7px;border:1px solid var(--line);border-radius:15px;background:var(--surface);margin-bottom:28px}
.mini-chip{display:block;border-radius:50%;background:#444}
.mini-chip.red{background:var(--red)}.mini-chip.yellow{background:var(--yellow)}
.eyebrow,.sheet-kicker,.gameover-kicker{font-size:10px;letter-spacing:.18em;font-weight:750;color:var(--muted);text-transform:uppercase}
.home-header h1{font-size:44px;line-height:1.02;letter-spacing:-1.8px;margin:10px 0 12px;font-weight:680}
.home-copy{max-width:410px;margin:0;color:#a4a4a6;font-size:15px;line-height:1.6}
.menu-stack{display:flex;flex-direction:column;gap:12px}
.menu-card{width:100%;border:1px solid var(--line);background:var(--surface);border-radius:22px;padding:21px 20px;display:flex;align-items:center;justify-content:space-between;text-align:left;transition:transform .16s ease,border-color .16s ease,background .16s ease;box-shadow:none}
.menu-card:active{transform:scale(.985);background:var(--surface-2)}
.menu-card.primary-card{border-color:#373a3e;background:#181a1c}
.menu-card-title{font-size:18px;font-weight:640;letter-spacing:-.25px}
.menu-card-meta{font-size:12px;color:var(--muted);margin-top:5px}
.menu-card-arrow{width:38px;height:38px;border-radius:50%;border:1px solid var(--line);display:grid;place-items:center;color:#b6b6b9;transition:transform .16s ease,background .16s ease}
.menu-card:active .menu-card-arrow{transform:translateX(3px);background:var(--surface-3)}
.home-footer{margin-top:auto;padding-top:28px;display:flex;justify-content:space-between;align-items:center;gap:16px}
.text-button{border:0;background:transparent;padding:9px 0;display:flex;align-items:center;gap:8px;color:#b9b9bb;font-size:13px}
.text-button .icon{width:17px;height:17px}
.offline-note{display:flex;align-items:center;gap:7px;font-size:11px;color:var(--muted-2);white-space:nowrap}
.status-dot{width:6px;height:6px;border-radius:50%;background:#7f9b80;box-shadow:0 0 0 3px rgba(127,155,128,.09)}

/* Game */
.game-screen{width:min(100%,620px);min-height:100vh;padding:calc(18px + env(safe-area-inset-top)) 18px calc(22px + env(safe-area-inset-bottom));display:flex;flex-direction:column}
.game-header{height:56px;display:grid;grid-template-columns:44px 1fr 44px;align-items:center;margin-bottom:12px}
.icon-button{width:42px;height:42px;border-radius:14px;border:1px solid var(--line);background:var(--surface);display:grid;place-items:center;color:#d0cec9;transition:transform .14s ease,background .14s ease,border-color .14s ease}
.icon-button:active:not(:disabled){transform:scale(.94);background:var(--surface-2)}
.icon-button:disabled{opacity:.28}
.icon-button.active{background:var(--text);color:var(--bg);border-color:var(--text)}
.game-heading{text-align:center;min-width:0}
.game-mode{font-size:14px;font-weight:650;letter-spacing:-.1px}
.game-status{font-size:11px;color:var(--muted);margin-top:3px;transition:color .2s ease}
.game-status.thinking{color:#b9a976}
.turn-chip{width:18px;height:18px;border-radius:50%;justify-self:center;box-shadow:inset 0 0 0 3px rgba(0,0,0,.16);transition:background .25s ease,transform .25s ease}
.turn-chip.red{background:var(--red)}.turn-chip.yellow{background:var(--yellow)}
.board-section{flex:1;display:flex;flex-direction:column;justify-content:center;min-height:0;padding:8px 0 14px}
.board-wrap{position:relative;width:100%}
.board-enter{animation:boardIn .42s cubic-bezier(.2,.8,.2,1) .06s both}
@keyframes boardIn{from{opacity:0;transform:scale(.985) translateY(8px)}to{opacity:1;transform:none}}
.board{position:relative;display:grid;grid-template-columns:repeat(7,1fr);grid-template-rows:repeat(6,1fr);gap:1.35%;padding:3.5%;aspect-ratio:7/6;background:var(--board);border-radius:28px;box-shadow:0 18px 50px rgba(0,0,0,.28)}
.cell{position:relative;border-radius:50%;background:var(--hole);box-shadow:inset 0 4px 7px rgba(0,0,0,.52)}
.piece{position:absolute;inset:7%;border-radius:50%;z-index:2;box-shadow:inset 0 -4px 8px rgba(0,0,0,.17),0 3px 8px rgba(0,0,0,.18)}
.piece.red{background:var(--red)}.piece.yellow{background:var(--yellow)}
.new-piece{animation:chipDrop .42s cubic-bezier(.23,.82,.35,1.02) both}
@keyframes chipDrop{0%{transform:translateY(-620%);opacity:.45}72%{transform:translateY(7%);opacity:1}100%{transform:none}}
.prediction-ring{position:absolute;inset:12%;border-radius:50%;background:transparent;border