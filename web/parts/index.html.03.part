';
const PERFECT_OPENING=Object.freeze({"":3,"1":3,"2":2,"3":3,"4":3,"5":3,"6":4,"7":3,"41":3,"42":1,"43":5,"44":3,"45":1,"46":5,"47":3,"141":3,"142":3,"143":3,"144":3,"145":3,"146":3,"147":3,"231":3,"232":1,"233":2,"234":3,"235":2,"236":2,"237":2,"341":3,"342":3,"343":2,"344":3,"345":3,"346":3,"347":3,"441":3,"442":2,"443":4,"444":3,"445":2,"446":4,"447":3,"541":3,"542":3,"543":3,"544":3,"545":4,"546":3,"547":3,"651":4,"652":4,"653":4,"654":3,"655":4,"656":5,"657":3,"741":3,"742":3,"743":3,"744":3,"745":3,"746":3,"747":3,"4141":3,"4142":3,"4143":3,"4144":3,"4145":3,"4146":3,"4147":3,"4221":2,"4222":3,"4223":4,"4224":3,"4225":3,"4226":3,"4227":3,"4361":3,"4362":3,"4363":2,"4364":3,"4365":3,"4366":6,"4367":5,"4441":3,"4442":3,"4443":3,"4444":3,"4445":3,"4446":3,"4447":3,"4521":1,"4522":0,"4523":3,"4524":3,"4525":4,"4526":3,"4527":3,"4661":3,"4662":3,"4663":3,"4664":3,"4665":2,"4666":3,"4667":4,"4741":3,"4742":3,"4743":3,"4744":3,"4745":3,"4746":3,"4747":3});
let perfectEnginePromise=null;
function perfectEngine(){
  if(!perfectEnginePromise){
    perfectEnginePromise=(async()=>{
      const bin=Uint8Array.from(atob(PERFECT_WASM_B64),c=>c.charCodeAt(0));
      const result=await WebAssembly.instantiate(bin,{});
      return result.instance.exports;
    })();
  }
  return perfectEnginePromise;
}
function loadPerfectPosition(e,seq){
  e.c4_reset();
  for(const ch of seq||''){const r=e.c4_play(Number(ch)-1);if(r!==1)throw new Error('Invalid solver position');}
}
async function perfectChoose(seq){
  if(Object.prototype.hasOwnProperty.call(PERFECT_OPENING,seq)) return {col:PERFECT_OPENING[seq],book:true};
  const e=await perfectEngine();loadPerfectPosition(e,seq);
  const col=e.c4_best_move_weak();
  return {col,book:false};
}
const searcher=new Searcher();
self.onmessage=async e=>{
  const {type,seq,difficulty,token,requestId}=e.data;
  try{
    const p=fromSequence(seq||'');
    if(type==='think'){
      if(difficulty==='impossible'){
        const pick=await perfectChoose(seq||'');
        self.postMessage({type:'move',col:pick.col,scores:null,token,perfect:true,book:pick.book});
        return;
      }
      const [depth,budget]=params(difficulty,p.moves,false),scores=searcher.analyze(p,depth,budget),col=chooseMove(scores,difficulty);
      self.postMessage({type:'move',col,scores,token});
    }else if(type==='predict'){
      const currentSeq=seq||'';
      // Exact opening-policy hits should remain instant and do not need a provisional result.
      if(Object.prototype.hasOwnProperty.call(PERFECT_OPENING,currentSeq)){
        self.postMessage({type:'prediction',col:PERFECT_OPENING[currentSeq],token,requestId,seq:currentSeq,perfect:true,book:true});
        return;
      }

      // Stage 1: return a strong move quickly using the same alpha-beta family as Vs AI.
      // This makes the hollow chip appear promptly instead of waiting on a difficult full solve.
      const quickDifficulty=e.data.fastDifficulty||'hard';
      const quickParams=params(quickDifficulty,p.moves,true);
      const quickScores=searcher.analyze(p,quickParams[0],quickParams[1]);
      const quickCol=chooseMove(quickScores,'impossible');
      self.postMessage({type:'predictionFast',col:quickCol,token,requestId,seq:currentSeq,perfect:false});

      // Stage 2: verify with the full-depth W/D/L engine. If the exact move differs,
      // the UI updates the same single hollow chip when verification completes.
      const pick=await perfectChoose(currentSeq);
      self.postMessage({type:'prediction',col:pick.col,token,requestId,seq:currentSeq,perfect:true,book:pick.book});
    }
  }catch(error){self.postMessage({type:'error',requestType:type,message:String(error&&error.message||error),token,requestId,seq:seq||''})}
};
</script><script src="app.js"></script></body></html>
