(function(){
  'use strict';
  var h=React.createElement;
  var ROWS=6,COLS=7;

  function emptyGrid(){return Array.from({length:ROWS},function(){return Array(COLS).fill(0);});}
  function difficultyLabel(value){return value==='impossible'?'Perfect':value.charAt(0).toUpperCase()+value.slice(1);}

  function Icon(props){
    var name=props.name, common={viewBox:'0 0 24 24',fill:'none',stroke:'currentColor',strokeWidth:'1.8',strokeLinecap:'round',strokeLinejoin:'round','aria-hidden':'true'};
    var children=[];
    if(name==='menu')children=[h('path',{d:'M5 7h14M5 12h14M5 17h14',key:'p'})];
    else if(name==='arrow')children=[h('path',{d:'M5 12h14M14 7l5 5-5 5',key:'p'})];
    else if(name==='undo')children=[h('path',{d:'M9 8 5 12l4 4M6 12h6.5a5.5 5.5 0 1 1 0 11',key:'p'})];
    else if(name==='prediction')children=[h('circle',{cx:'12',cy:'12',r:'7',key:'c'}),h('circle',{cx:'12',cy:'12',r:'2',key:'d'})];
    else if(name==='settings')children=[h('circle',{cx:'12',cy:'12',r:'3',key:'c'}),h('path',{d:'M19 12a7 7 0 0 0-.12-1.3l2.02-1.56-2-3.46-2.48 1a7 7 0 0 0-2.25-1.3L13.82 3h-4l-.35 2.38a7 7 0 0 0-2.25 1.3l-2.48-1-2 3.46 2.02 1.56A7 7 0 0 0 4.64 12c0 .45.04.88.12 1.3l-2.02 1.56 2 3.46 2.48-1a7 7 0 0 0 2.25 1.3L9.82 21h4l.35-2.38a7 7 0 0 0 2.25-1.3l2.48 1 2-3.46-2.02-1.56c.08-.42.12-.85.12-1.3Z',key:'p'})];
    else if(name==='restart')children=[h('path',{d:'M20 7v5h-5M19 12a7 7 0 1 0-2 5',key:'p'})];
    else if(name==='home')children=[h('path',{d:'m4 11 8-7 8 7v9h-6v-6h-4v6H4z',key:'p'})];
    else if(name==='play')children=[h('path',{d:'m9 7 8 5-8 5z',key:'p'})];
    else if(name==='close')children=[h('path',{d:'m7 7 10 10M17 7 7 17',key:'p'})];
    return h('svg',Object.assign({className:'icon'},common),children);
  }

  function IconButton(props){
    return h('button',{className:'icon-button'+(props.active?' active':''),onClick:props.onClick,disabled:!!props.disabled,'aria-label':props.label,title:props.label},h(Icon,{name:props.icon}));
  }

  function ActionButton(props){
    return h('button',{className:'action-button'+(props.active?' active':''),onClick:props.onClick,disabled:!!props.disabled},
      h(Icon,{name:props.icon}),h('span',null,props.label),props.active?h('span',{className:'active-dot'}):null
    );
  }

  function LogoMark(){
    return h('div',{className:'logo-mark','aria-hidden':'true'},
      h('img',{src:'app-icon.svg',alt:'',className:'logo-image'})
    );
  }

  function HomeMenu(props){
    var aiMeta=difficultyLabel(props.difficulty)+' AI · '+(props.humanPlayer===1?'Play Red':'Play Yellow');
    return h('main',{className:'home-screen screen-enter'},
      h('div',{className:'home-header'},h(LogoMark),h('div',{className:'eyebrow'},'CONNECT4 AI'),h('h1',null,'Think ahead.'),h('p',{className:'home-copy'},'A quiet game of strategy with a clean board, smooth animations, and an AI-powered solver for sharp play and best-move guidance.')),
      h('div',{className:'menu-stack'},
        h('button',{className:'menu-card primary-card',onClick:function(){props.onStart('ai');}},
          h('div',{className:'menu-card-copy'},h('div',{className:'menu-card-title'},'Play vs AI'),h('div',{className:'menu-card-meta'},aiMeta)),
          h('span',{className:'menu-card-arrow'},h(Icon,{name:'arrow'}))
        ),
        h('button',{className:'menu-card',onClick:function(){props.onStart('two');}},
          h('div',{className:'menu-card-copy'},h('div',{className:'menu-card-title'},'Two players'),h('div',{className:'menu-card-meta'},'Local pass & play')), 
          h('span',{className:'menu-card-arrow'},h(Icon,{name:'arrow'}))
        )
      ),
      h('div',{className:'home-footer'},
        h('button',{className:'text-button',onClick:props.onSettings},h(Icon,{name:'settings'}),h('span',null,'Game settings')),
        h('div',{className:'offline-note'},h('span',{className:'status-dot'}),'Offline · Exact solver')
      )
    );
  }

  function SettingsModal(props){
    if(!props.open)return null;
    var difficulties=['easy','medium','hard','impossible'];
    return h('div',{className:'modal sheet-modal'},
      h('div',{className:'backdrop fade-in',onClick:props.onCancel}),
      h('section',{className:'sheet slide-up','aria-label':'Game settings'},
        h('div',{className:'sheet-handle'}),
        h('div',{className:'sheet-head'},h('div',null,h('div',{className:'sheet-kicker'},'SETTINGS'),h('div',{className:'sheet-title'},'Game setup')),h(IconButton,{icon:'close',label:'Close',onClick:props.onCancel})),
        h('div',{className:'sheet-body'},
          h('div',{className:'setting-group'},h('div',{className:'setting-label'},'Mode'),
            h('div',{className:'segmented'},
              h('button',{className:props.mode==='ai'?'selected':'',onClick:function(){props.onMode('ai');}},'Vs AI'),
              h('button',{className:props.mode==='two'?'selected':'',onClick:function(){props.onMode('two');}},'2 Players')
            )
          ),
          props.mode==='ai'?h('div',null,
            h('div',{className:'setting-group'},h('div',{className:'setting-label'},'Your color'),
              h('div',{className:'color-options'},
                h('button',{className:'color-option'+(props.player==='p1'?' selected':''),onClick:function(){props.onPlayer('p1');}},h('span',{className:'color-chip red'}),h('span',null,'Red'),h('small',null,'First')),
                h('button',{className:'color-option'+(props.player==='p2'?' selected':''),onClick:function(){props.onPlayer('p2');}},h('span',{className:'color-chip yellow'}),h('span',null,'Yellow'),h('small',null,'Second'))
              )
            ),
            h('div',{className:'setting-group'},h('div',{className:'setting-label'},'Difficulty'),
              h('div',{className:'difficulty-grid'},difficulties.map(function(d){return h('button',{key:d,className:props.difficulty===d?'selected':'',onClick:function(){props.onDifficulty(d);}},difficultyLabel(d));}))
            )
          ):h('div',{className:'two-player-note'},'