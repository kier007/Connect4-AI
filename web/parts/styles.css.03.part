ing-bottom:6px}.analysis-line{margin-top:8px}.action-button{height:42px}.board{border-radius:22px}
}

.logo-mark{width:68px;height:68px;border-radius:20px;display:grid;place-items:center;overflow:hidden;box-shadow:0 10px 30px rgba(0,0,0,.24)}
.logo-image{width:100%;height:100%;display:block;border-radius:20px;object-fit:cover}
.mini-chip{display:none}
