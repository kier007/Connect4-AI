,75];if(difficulty==='hard')return[6,120];return[7,180]}
  if(difficulty==='easy')return[4,60];
  if(difficulty==='medium')return[6,140];
  if(difficulty==='hard')return[8,330];
  let depth=10,budget=760;if(rem<=18){depth=Math.min(rem,12);budget=900}if(rem<=12){depth=rem;budget=1100}return[depth,budget];
}
function chooseMove(scores,difficulty){
  const options=[];for(let c=0;c<7;c++)if(scores[c]!==null)options.push([c,scores[c]]);if(!options.length)return null;
  if(difficulty==='impossible')return options.reduce((a,b)=>b[1]>a[1]?b:a)[0];
  const temp=difficulty==='easy'?.25:difficulty==='medium'?.10:.025;
  let maxAbs=1;for(const [,s] of options)maxAbs=Math.max(maxAbs,Math.abs(s));
  const vals=options.map(([c,s])=>[c,Math.max(-1,Math.min(1,s/maxAbs))]);const maxV=Math.max(...vals.map(x=>x[1]/temp));
  const weights=vals.map(([,v])=>Math.exp(v/temp-maxV));let total=weights.reduce((a,b)=>a+b,0),r=Math.random()*total;
  for(let i=0;i<weights.length;i++){r-=weights[i];if(r<=0)return vals[i][0]}return vals[vals.length-1][0];
}

